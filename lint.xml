<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Disable specific lint checks -->
    <issue id="InvalidPackage" severity="ignore" />
    <issue id="GradleDependency" severity="warning" />
    <issue id="OldTargetApi" severity="warning" />
    <issue id="UnusedResources" severity="warning">
        <ignore path="res/values-*" />
    </issue>
    
    <!-- Enable specific lint checks -->
    <issue id="ContentDescription" severity="error" />
    <issue id="RtlCompat" severity="error" />
    <issue id="RtlEnabled" severity="error" />
    <issue id="RtlSymmetry" severity="error" />
    <issue id="LogConditional" severity="error" />
    <issue id="ObsoleteLintCustomCheck" severity="error" />
    
    <!-- Baseline configuration -->
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="ExtraTranslation" severity="ignore" />
    <issue id="ImpliedQuantity" severity="ignore" />
    
    <!-- Performance checks -->
    <issue id="Overdraw" severity="warning" />
    <issue id="UseCompoundDrawables" severity="warning" />
    <issue id="UselessParent" severity="warning" />
    <issue id="DuplicateIncludedIds" severity="error" />
    <issue id="MergeRootFrame" severity="warning" />
    
    <!-- Security checks -->
    <issue id="AllowBackup" severity="error">
        <ignore path="AndroidManifest.xml" />
    </issue>
    <issue id="ExportedContentProvider" severity="error" />
    <issue id="ExportedReceiver" severity="error" />
    <issue id="ExportedService" severity="error" />
    <issue id="GrantAllUris" severity="error" />
    <issue id="WorldReadableFiles" severity="error" />
    <issue id="WorldWriteableFiles" severity="error" />
    
    <!-- Correctness checks -->
    <issue id="CommitPrefEdits" severity="error" />
    <issue id="CommitTransaction" severity="error" />
    <issue id="Recycle" severity="error" />
    <issue id="Wakelock" severity="error" />
    <issue id="Unlock" severity="error" />
</lint>
