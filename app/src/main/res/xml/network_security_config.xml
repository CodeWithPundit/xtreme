<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config with cleartext traffic allowed for development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Domain-specific configurations -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.</domain>
        <domain includeSubdomains="true">10.0.</domain>
        <domain includeSubdomains="true">172.16.</domain>
    </domain-config>
    
    <!-- Debug config with additional permissions -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
